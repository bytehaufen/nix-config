[
  {
    "label": "Python: active file",
    "adapter": "Debugpy",
    "request": "launch",
    "program": "$ZED_FILE",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Rust: build and debug",
    "adapter": "CodeLLDB",
    "build": {
      "command": "cargo",
      "args": [
        "build"
      ]
    },
    "sourceLanguages": [
      "rust"
    ]
  },
  {
    "label": "Node: active JavaScript file",
    "adapter": "JavaScript",
    "type": "node",
    "request": "launch",
    "program": "$ZED_FILE",
    "cwd": "$ZED_WORKTREE_ROOT",
    "skipFiles": [
      "<node_internals>/**"
    ]
  }
]
