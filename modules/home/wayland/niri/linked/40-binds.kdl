binds {
    Mod+Shift+Slash {
        show-hotkey-overlay
    }
    // Show app information, like app-id, title, etc.
    Mod+Shift+I repeat=false {
        spawn-sh "info=\"$(niri msg pick-window)\" && tmp=$(mktemp /tmp/niri-info.XXXXXX) && printf '%s\n' \"$info\" > \"$tmp\" && kitty --detach nvim \"$tmp\""
    }
    Mod+Escape allow-inhibiting=false {
        toggle-keyboard-shortcuts-inhibit
    }
    Mod+Shift+Q {
        quit skip-confirmation=true
    }
    Mod+O repeat=false {
        toggle-overview
    }
    Mod+Q {
        close-window
    }
    Mod+H {
        focus-column-or-monitor-left
    }
    Mod+L {
        focus-column-or-monitor-right
    }
    Mod+K {
        focus-window-or-workspace-up
    }
    Mod+J {
        focus-window-or-workspace-down
    }
    Mod+Shift+H {
        move-column-left-or-to-monitor-left
    }
    Mod+Shift+L {
        move-column-right-or-to-monitor-right
    }
    Mod+Shift+K {
        move-window-up-or-to-workspace-up
    }
    Mod+Shift+J {
        move-window-down-or-to-workspace-down
    }
    Mod+WheelScrollDown cooldown-ms=150 {
        focus-workspace-down
    }
    Mod+WheelScrollUp cooldown-ms=150 {
        focus-workspace-up
    }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 {
        move-column-to-workspace-down
    }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 {
        move-column-to-workspace-up
    }
    Mod+WheelScrollRight cooldown-ms=150 {
        focus-column-right
    }
    Mod+WheelScrollLeft cooldown-ms=150 {
        focus-column-left
    }
    Mod+Shift+WheelScrollDown cooldown-ms=150 {
        focus-column-right
    }
    Mod+Shift+WheelScrollUp cooldown-ms=150 {
        focus-column-left
    }
    Mod+B {
        switch-preset-column-width
    }
    Mod+Shift+B {
        switch-preset-column-width-back
    }
    Mod+Ctrl+H {
        set-column-width "-10%"
    }
    Mod+Ctrl+L {
        set-column-width "+10%"
    }
    Mod+F {
        maximize-column
    }
    Mod+M {
        fullscreen-window
    }
    Mod+V {
        toggle-window-floating
    }
    Mod+Shift+V {
        switch-focus-between-floating-and-tiling
    }
    Mod+Comma {
        focus-monitor-left
    }
    Mod+Period {
        focus-monitor-right
    }
    Mod+Shift+Comma {
        move-column-to-monitor-left
    }
    Mod+Shift+Period {
        move-column-to-monitor-right
    }
    Mod+Ctrl+Comma {
        move-workspace-to-monitor-left
    }
    Mod+Ctrl+Period {
        move-workspace-to-monitor-right
    }
    Mod+1 {
        focus-workspace 1
    }
    Mod+2 {
        focus-workspace 2
    }
    Mod+3 {
        focus-workspace 3
    }
    Mod+4 {
        focus-workspace 4
    }
    Mod+5 {
        focus-workspace 5
    }
    Mod+6 {
        focus-workspace 6
    }
    Mod+7 {
        focus-workspace 7
    }
    Mod+8 {
        focus-workspace 8
    }
    Mod+9 {
        focus-workspace 9
    }
    Mod+0 {
        focus-workspace 10
    }
    Mod+Shift+1 {
        move-column-to-workspace 1
    }
    Mod+Shift+2 {
        move-column-to-workspace 2
    }
    Mod+Shift+3 {
        move-column-to-workspace 3
    }
    Mod+Shift+4 {
        move-column-to-workspace 4
    }
    Mod+Shift+5 {
        move-column-to-workspace 5
    }
    Mod+Shift+6 {
        move-column-to-workspace 6
    }
    Mod+Shift+7 {
        move-column-to-workspace 7
    }
    Mod+Shift+8 {
        move-column-to-workspace 8
    }
    Mod+Shift+9 {
        move-column-to-workspace 9
    }
    Mod+Shift+0 {
        move-column-to-workspace 10
    }
    Print {
        screenshot
    }
    Ctrl+Print {
        screenshot-screen
    }
    Alt+Print {
        screenshot-window
    }
    // App launching
    Mod+Return {
        spawn "kitty"
    }
    Mod+W {
        spawn "brave"
    }
    Mod+E {
        spawn "nautilus"
    }
    Mod+Space {
        spawn-sh "noctalia-shell ipc call launcher toggle"
    }
    XF86Search {
        spawn "noctalia-shell ipc call launcher toggle"
    }
    Mod+Alt+L {
        spawn "noctalia-shell ipc call lockScreen lock"
    }
    Mod+BackSpace {
        switch-layout "next"
    }
    Mod+Alt+R {
        spawn "record-area"
    }
    Mod+Alt+S {
        spawn "screenshot-area"
    }
    Mod+Shift+N {
        spawn-sh "noctalia-shell ipc call desktopWidgets edit"
    }
    // Keyboard hotkeys
    XF86AudioRaiseVolume allow-when-locked=true {
        spawn-sh "noctalia-shell ipc call volume increase"
    }
    XF86AudioLowerVolume allow-when-locked=true {
        spawn-sh "noctalia-shell ipc call volume decrease"
    }
    XF86AudioMute allow-when-locked=true {
        spawn-sh "noctalia-shell ipc call volume muteOutput"
    }
    XF86AudioMicMute allow-when-locked=true {
        spawn-sh "noctalia-shell ipc call volume muteInput"
    }
    XF86AudioPlay allow-when-locked=true {
        spawn-sh "noctalia-shell ipc call media playPause"
    }
    XF86AudioStop allow-when-locked=true {
        spawn-sh "noctalia-shell ipc call media pause"
    }
    XF86AudioPrev allow-when-locked=true {
        spawn-sh "noctalia-shell ipc call media previous"
    }
    XF86AudioNext allow-when-locked=true {
        spawn-sh "noctalia-shell ipc call media next"
    }
    XF86MonBrightnessUp allow-when-locked=true {
        spawn-sh "noctalia-shell ipc call brightness increase"
    }
    XF86MonBrightnessDown allow-when-locked=true {
        spawn-sh "noctalia-shell ipc call brightness decrease"
    }
    XF86KbdBrightnessUp allow-when-locked=true {
        spawn-sh "brightnessctl --device=kbd_backlight set 10%+"
    }
    XF86KbdBrightnessDown allow-when-locked=true {
        spawn-sh "brightnessctl --device=kbd_backlight set 10%-"
    }
    XF86Calculator {
        spawn-sh "pkill gnome-calculator || gnome-calculator"
    }
}
